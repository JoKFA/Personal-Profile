# Copy to .env.local for local development. Never commit real keys.
# In production: set these in Vercel dashboard -> Settings -> Environment Variables.

# DeepSeek API key powers the /api/redteam prompt-injection lab.
DEEPSEEK_API_KEY=sk-your-key-here

# The production challenge flag. Do not commit the real value.
REDTEAM_FLAG=SENTINEL{replace_this_in_vercel_only}

# Optional: override the model (default is deepseek-chat).
# DEEPSEEK_MODEL=deepseek-chat

# Optional: override the global hourly attempt cap (budget kill-switch).
# REDTEAM_HOURLY_CAP=1000

# Optional but recommended in production: shared Vercel/serverless rate limits.
# Create an Upstash Redis database and set both values.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Public canonical URL used for robots.txt and sitemap.xml during build.
SITE_URL=https://personal-profile-alpha-cyan.vercel.app

# Contact form.
RESEND_API_KEY=re_your-key-here
# Use onboarding@resend.dev for Resend sandbox testing, or a verified custom domain in production.
CONTACT_FROM_EMAIL="Yaoting Wang <onboarding@resend.dev>"
CONTACT_TO_EMAIL=you@example.com
