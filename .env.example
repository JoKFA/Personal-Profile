# Copy to .env.local for local development. Never commit real keys.
# In production: set these in Vercel dashboard → Settings → Environment Variables.

# Anthropic API key powers the /api/redteam prompt-injection lab.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model (default is claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: override the global hourly attempt cap (budget kill-switch).
# REDTEAM_HOURLY_CAP=1000

# Contact form (existing, unrelated).
RESEND_API_KEY=re_your-key-here
CONTACT_FROM_EMAIL=portfolio@your-domain.com
CONTACT_TO_EMAIL=you@example.com
